# Optional. Without these, Gnosis runs local-only (no sign-in, progress in localStorage).
# Both values are public; never put a service_role or secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://qmjcdcceipacxgxoxfgb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_l__HZc8ac_qYVo2kWPDuPw_IwyLgAih

# Optional. Without OPENROUTER_API_KEY the dive-deeper panel is hidden.
# Server-only: never prefix these with NEXT_PUBLIC_.
# OPENROUTER_MODEL overrides the default (anthropic/claude-haiku-5.5).
# The picker only offers the built-in list; a saved choice beats this default.
# If OPENROUTER_MODEL is some other model id, the server uses it until the learner picks one.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Per signed-in user, per UTC day. Web lookups also count toward CHAT_DAILY_LIMIT.
CHAT_DAILY_LIMIT=40
CHAT_DAILY_WEB_LIMIT=10
